# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,localhost

# Database Configuration
# PostgreSQL database settings for production
# Development: Use SQLite (default in Django)
DATABASE_URL=postgres://lingua:lingua@localhost:5432/lingua_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lingua_db
DB_USER=lingua
DB_PASSWORD=lingua

# JWT Configuration
JWT_SECRET_KEY=change-this-in-production-to-a-random-secret-key
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Application Settings
USE_TZ=True
TIME_ZONE=UTC
DEFAULT_AUTO_FIELD=django.db.models.BigAutoField

# File Upload Settings
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB
MAX_UPLOAD_FILE_SIZE=10485760  # 10MB

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/lingua.log
